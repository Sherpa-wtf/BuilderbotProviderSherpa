{
    "compilerOptions": {
        "allowJs": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "skipLibCheck": true,
        "outDir": "./dist",
        "rootDir": "./src",
        "declaration": true,
        "declarationMap": true,
        "module": "esnext",
        "moduleResolution": "bundler",
        "importHelpers": true,
        "target": "es2021",
        "types": [
            "node",
            "jest"
        ],
    },
    "include": ["src/**/*.js", "src/**/*.ts"],
    "exclude": ["**/*.spec.ts", "**/*.test.ts", "node_modules"]
}
